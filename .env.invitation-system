# Roomio Invitation System Configuration
# Copy this to .env and update with your actual values

# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration
NUXT_PUBLIC_BASE_URL=http://localhost:3000
NUXT_PUBLIC_AUTH_BACKGROUND_URL=https://images.unsplash.com/photo-1566073771259-6a8506099945

# Email Configuration
# Options: console, sendgrid, resend, mailgun
EMAIL_PROVIDER=console
EMAIL_API_KEY=your_email_service_api_key
EMAIL_FROM=noreply@roomio.com
EMAIL_FROM_NAME=Roomio Team

# Admin Configuration
ADMIN_EMAIL=admin@roomio.com

# SendGrid Configuration (if using SendGrid)
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=your_sendgrid_api_key

# Resend Configuration (if using Resend)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=your_resend_api_key

# Mailgun Configuration (if using Mailgun)
# EMAIL_PROVIDER=mailgun
# EMAIL_API_KEY=your_mailgun_api_key

# Development Settings
NODE_ENV=development
